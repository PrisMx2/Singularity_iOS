[sub_resource type="GDScript" id="GDScript_ifow5"]
script/source = "extends Control

@onready var background: Node2D = $background
@onready var fit: HBoxContainer = $background/fit
@onready var title: Label = $background/fit/title
@onready var questioning: Button = $background/fit/questioning

@onready var button: PanelContainer = $button
@onready var button_button: Button = $button/button
@onready var switch: Node2D = $switch
@onready var switch_button: Button = $switch/button
@onready var picker: Node2D = $picker
@onready var picker_value: Label = $picker/value
@onready var progress: Node2D = $progress
@onready var progress_drag: Button = $progress/frame/drag
@onready var input: Node2D = $input
@onready var input_edit: LineEdit = $input/edit

@onready var controls: Array = [
	button, button_button,
	switch, switch_button,
	picker, picker_value,
	progress, progress_drag,
	input, input_edit,
]

func _ready() -> void:
	for control: Button in [
		questioning,
		button_button,
		switch_button,
		$picker/decrease,
		$picker/increase,
	]:
		control.scroller = get_parent()

func refresh_size() -> void:
	fit.visible = false
	fit.visible = true

func load_data(data: Dictionary) -> void:
	background.position.x = 78.5 if data.connected else 0.0
	title.text = data.title
	questioning.set_data(data)

	var type: int = data.type
	for index: int in range(0, 10, 2):
		var control: Node = controls[index]
		if type * 2 == index:
			control.visible = true
			control.process_mode = ProcessMode.PROCESS_MODE_INHERIT
			controls[index + 1].set_data(data)
		else:
			control.visible = false
			control.process_mode = ProcessMode.PROCESS_MODE_DISABLED
"

[sub_resource type="GDScript" id="GDScript_yc4a7"]
script/source = "extends \"res://scripts/generic_button.gd\"

var _callback: Callable

func _pressed() -> void:
	_callback.call()

func set_data(data: Dictionary) -> void:
	if data.has(\"questioning\"):
		visible = true
		_callback = data.questioning
	else:
		visible = false
"

[sub_resource type="GDScript" id="GDScript_ql1j0"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var label: Label

var _callback: Callable

func _pressed() -> void:
	_callback.call(null)

func set_data(data: Dictionary) -> void:
	label.text = data.text
	_callback = data.callback
"

[sub_resource type="GDScript" id="GDScript_fkds6"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var label: Label
@export var on: Sprite2D

var _switch: bool = true
var _callback: Callable

func _pressed() -> void:
	_switch = not _switch
	on.visible = _switch
	_callback.call(_switch)

func set_data(data: Dictionary) -> void:
	label.text = data.text
	_switch = data.enabled
	on.visible = _switch
	_callback = data.callback
"

[sub_resource type="GDScript" id="GDScript_6dbjw"]
script/source = "extends Label

@export var decrease: Button
@export var increase: Button

var _index: int = 0
var _callback: Callable

func _add(value: int) -> void:
	_index += value
	_callback.call(_index)

func _ready() -> void:
	decrease.pressed.connect(_add.bind(-1))
	increase.pressed.connect(_add.bind(1))

func set_data(data: Dictionary) -> void:
	_index = data.index
	_callback = data.callback
	text = data.text
"

[sub_resource type="GDScript" id="GDScript_wvhbo"]
script/source = "extends \"res://scripts/generic_progress_bar.gd\"

@export var pointer: Sprite2D

func _process(_delta: float) -> void:
	var value: float = _update()
	pointer.offset.x = value * size.x / 0.6
"

[sub_resource type="GDScript" id="GDScript_vl0iy"]
script/source = "extends Button

@export var label: Label
@export var value: ColorRect

var _callback: Callable
var _touch_index: int = -1

func _tween_break() -> void:
	_touch_index = -1

func _calcuate(event: InputEvent) -> void:
	event = make_input_local(event)
	var progress: float = clampf( ( event.position.x - 20.0 ) / value.size.x, 0.0, 1.0 )
	_callback.call(progress)

func _input(event: InputEvent) -> void:
	if can_process():
		if event is InputEventScreenTouch:
			if event.pressed == true:
				var rect: Rect2 = get_global_rect()
				if rect.has_point(event.position):
					_touch_index = event.index
					_calcuate(event)
			elif event.index == _touch_index:
				_touch_index = -1
		elif event is InputEventScreenDrag:
			if _touch_index == event.index:
				_calcuate(event)

func set_data(data: Dictionary) -> void:
	value.set_value_break(data.progress)
	_callback = data.callback
	label.text = data.text
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_riygu"]

[sub_resource type="GDScript" id="GDScript_wyyig"]
script/source = "extends LineEdit

var _callback: Callable

func _ready() -> void:
	text_changed.connect(func(_text: String):
		SoundManager.play(\"input\")
		_callback.call(_text)
	)

func set_data(data: Dictionary) -> void:
	_callback = data.callback
	placeholder_text = data.hint
	var caret: int = caret_column
	text = data.text
	caret_column = mini(caret, text.length())
"

