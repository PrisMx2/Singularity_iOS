[sub_resource type="GDScript" id="GDScript_bn54a"]
script/source = "extends \"res://scripts/generic_hscroll.gd\"

@export var root: Node2D
@export var main_ui: ColorRect

var _touch_position: Vector2 = Vector2(0.0, 0.0)
var _dragging: int = -1
var _dragging_beat: float = 0.0

func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed and not event.canceled:
			if _touch_index == -1:
				var rect: Rect2 = get_global_rect()
				rect.position -= position
				if not rect.has_point(event.position):
					return
				var local_event: InputEvent = make_input_local(event)
				_touch_index = event.index
				_touch_position = local_event.position
				_dragging = -1
				var x: float = event.position.x * 2.0 - position.x
				_scroll_time = _get_time()
				_scroll_record = position.x
				_scroll_base = x
				_scroll_pixel = x
				_scroll_target = x
				_scroll_speed = 0.0
				accept_event()
		else:
			if _touch_index == event.index:
				_touch_index = -1
				if _dragging == 1:
					root.seek_end()
				accept_event()
	elif event is InputEventScreenDrag:
		if _touch_index == event.index:
			var local_event: InputEvent = make_input_local(event)
			var delta_vec: Vector2 = local_event.position - _touch_position
			if _dragging == 1:
				var scrolled: float = _dragging_beat + main_ui.height_to_beat_absolute(delta_vec.y)
				root.seek_beat(scrolled)
			elif _dragging == 2:
				_scroll_target = event.position.x * 2.0 - position.x
			else:
				var distance: float = delta_vec.length()
				if distance > 25.0:
					_touch_position = local_event.position
					if absf(delta_vec.y) > absf(delta_vec.x):
						_dragging = 1
						_dragging_beat = root.beat
						root.seek_begin()
					else:
						_dragging = 2
						var x: float = event.position.x * 2.0 - position.x
						_scroll_time = _get_time()
						_scroll_record = position.x
						_scroll_base = x
						_scroll_pixel = x
						_scroll_target = x
						_scroll_speed = 0.0
			accept_event()
"

