[sub_resource type="GDScript" id="GDScript_wvhbo"]
script/source = "extends ColorRect

const font: FontVariation = preload(\"res://fonts/IosevkaAileMix.Regular.tres\")

const corner: Vector2 = Vector2(1920.0, 0.0)

@export var root: Node2D
@export var drawer: Node2D

@onready var center: Vector2 = size / 2.0
@onready var arc_radius: float = center.x * 2.4

var _touch_index: int = -1
var _select_chain: Array = []
var _current_selected: Variant = null

func _ready() -> void:
	drawer.draw.connect(__draw)

func _tween_break() -> void:
	_touch_index = -1

func __draw() -> void:
	var next: Array = root.drag_menu
	var radius: float = center.x - arc_radius / 2.0
	for i: int in _select_chain.size():

		var arc: float = - PI / 2.0 / next.size()
		for j: int in next.size():
			var item: Array = next[j]
			var angle: float = arc * j
			radius = center.x + arc_radius * ( i + 0.5 )
			drawer.draw_set_transform(center, angle + PI)
			var _color: Color = Color(0xCCCCFFBB) if j == _select_chain[i] else Color(0xCCCCFFFF)
			drawer.draw_arc(Vector2(0.0, 0.0), radius, 0.0, arc, 128, _color, arc_radius, false)
			angle += arc / 2.0
			var text_position: Vector2 = center - Vector2(radius + arc_radius / 2.0, 0.0).rotated(angle)
			drawer.draw_set_transform(text_position, angle)
			var text: String = item[0]
			drawer.draw_string(font, Vector2(0.0, 10.0), text, HORIZONTAL_ALIGNMENT_CENTER, arc_radius, 36, Color(0x000000FF))

		next = next[_select_chain[i]]
		if next[1] is Array:
			next = next[1]
		else:
			return

	if _touch_index == -1:
		return

	radius += arc_radius
	drawer.draw_set_transform(center, 0.0)
	drawer.draw_arc(Vector2(0.0, 0.0), radius, 0.0, TAU, 128, Color(0xCCCCFFFF), arc_radius, true)

	var _arc: float = - PI / 2.0 / next.size()
	var index: int = 0
	for item: Array in next:
		var angle: float = _arc * ( index + 0.5 )
		var text_position: Vector2 = center - Vector2(radius + arc_radius / 2.0, 0.0).rotated(angle)
		drawer.draw_set_transform(text_position, angle)
		var text: String = item[0]
		drawer.draw_string(font, Vector2(0.0, 10.0), text, HORIZONTAL_ALIGNMENT_CENTER, arc_radius, 36, Color(0x000000FF))
		index += 1

func _calc(_position: Vector2) -> void:
	_position.x = maxf(_position.x, 0.0)
	_position.y = minf(_position.y, 0.0)
	var depth: int = roundi( ( _position.length() - center.x ) / arc_radius + 0.5 )
	var next: Variant = root.drag_menu
	var chain: Array = []
	for i: int in depth:
		var chain_size: int = _select_chain.size()
		var division: int = next.size()
		var select: int
		if i >= chain_size - 1:
			select = - floori(_position.angle() / ( PI / division / 2.0 )) - 1
			select = clampi(select, 0, division - 1)
			chain.append(select)
		else:
			select = _select_chain[i]
			chain.append(select)
		next = next.get(select)
		_current_selected = next[1]
		if next == null or next[1] is Callable:
			break
		next = next[1]
	_select_chain = chain
	drawer.queue_redraw()

func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed == true:
			if _touch_index == -1:
				var _position: Vector2 = corner - event.position
				if _position.length() > center.x:
					return
				_touch_index = event.index
				_calc(_position)
				accept_event()
		elif event.index == _touch_index:
			_touch_index = -1
			_select_chain = []
			if _current_selected is Callable:
				_current_selected.call()
			_current_selected = null
			drawer.queue_redraw()
			accept_event()
	elif event is InputEventScreenDrag:
		if event.index == _touch_index:
			var _position: Vector2 = corner - event.position
			_calc(_position)
			accept_event()
"

[sub_resource type="GDScript" id="GDScript_q68jb"]
