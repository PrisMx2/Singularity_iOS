	pointer.offset.x = value * size.x / 0.6
"

[sub_resource type="GDScript" id="GDScript_xg7d5"]
script/source = "extends Button

@export var root: Node2D
@export var value: ColorRect

var _touch_index: int = -1

func _tween_break() -> void:
	_touch_index = -1

func _calcuate(event: InputEvent) -> void:
	event = make_input_local(event)
	var progress: float = clampf( ( event.position.x - 15.0 ) / value.size.x, 0.0, 1.0 )
	value.set_value_break(progress)
	root.seek_progress(progress)

func set_value(progress: float) -> void:
	progress = clampf(progress, 0.0, 1.0)
	value.set_value_break(progress)

func _input(event: InputEvent) -> void:
	if can_process():
		if event is InputEventScreenTouch:
			if event.pressed and not event.canceled:
				var rect: Rect2 = get_global_rect()
				if rect.has_point(event.position):
					_touch_index = event.index
					root.seek_begin()
					_calcuate(event)
			elif event.index == _touch_index:
				_touch_index = -1
				root.seek_end()
		elif event is InputEventScreenDrag:
			if _touch_index == event.index:
				_calcuate(event)
"

[sub_resource type="GDScript" id="GDScript_o07iq"]
script/source = "extends \"res://scripts/generic_button.gd\"

const play_icon: CompressedTexture2D = preload(\"res://textures/editor/play.png\")
const pause_icon: CompressedTexture2D = preload(\"res://textures/editor/pause.png\")

@export var root: Node2D

func _pressed() -> void:
	if root.playing():
		root.pause()
		icon = play_icon
	else:
		root.play()
		icon = pause_icon
"

