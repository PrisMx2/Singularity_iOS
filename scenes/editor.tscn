[sub_resource type="GDScript" id="GDScript_j3pel"]
script/source = "extends Control

const font: FontVariation = preload(\"res://fonts/IosevkaAileMix.Regular.tres\")

const width: float = 1536.0
const height: float = 864.0
const grids: int = 20
const grid_height: float = height / grids
const base_ratio: float = 0.2
const inv_base_ratio: float = 1.0 - base_ratio
const base_height: float = height * inv_base_ratio

@export var root: Node2D
@export var progress_drag: Button

var beat_zoom: float = 4.0

func beat_to_height(beat: float) -> float:
	return base_height - ( beat - root.beat ) * beat_zoom * grid_height

func height_to_beat_absolute(_height: float) -> float:
	var inv_zoom: float = 1.0 / beat_zoom
	return _height / grid_height * inv_zoom

func height_to_beat_round(_height: float) -> float:
	var inv_zoom: float = 1.0 / beat_zoom
	return snappedf( root.beat - ( _height - base_height ) / grid_height * inv_zoom, inv_zoom )

func height_to_beat_floor(_height: float) -> float:
	var inv_zoom: float = 1.0 / beat_zoom
	return snappedf( root.beat - ( ( _height - base_height ) / grid_height + 0.5 ) * inv_zoom, inv_zoom )

func _draw() -> void:
	if root.valid():
		var step: float = 1.0 / beat_zoom
		var beat: float = root.beat
		var aligned: float = snappedf(beat, step)
		for i: int in range(-1 - base_ratio * grids, 2 + inv_base_ratio * grids):
			var line_beat: float = aligned + i * step
			var y: float = beat_to_height(line_beat)
			if fmod(line_beat, 1.0) == 0:
				draw_line(Vector2(0.0, y), Vector2(width, y), Color(0xFFFFFFFF), 3.2, true)
			else:
				draw_line(Vector2(0.0, y), Vector2(width, y), Color(0xD3D3D3FF), 1.0, true)
			draw_string(font, Vector2(-5.0, y - 10.0), str(line_beat), HORIZONTAL_ALIGNMENT_RIGHT, width, 20, Color(0xFFFFFFFF))
	draw_line(Vector2(0.0, base_height), Vector2(width, base_height), Color(0x99CCEFFF), 4.5, true)

func _process(_delta: float) -> void:
	queue_redraw()
"

