[sub_resource type="GDScript" id="GDScript_wvhbo"]
script/source = "extends Node2D

@onready var player: Node3D = SceneManager.get_scene(\"player\")
@onready var player_ui: Node2D = SceneManager.get_scene(\"player_ui\")

@onready var illust: TextureRect = $title/illustration
@onready var title: Label = $title/mask/title
@onready var artist: Label = $title/mask/artist
@onready var difficulty: Control = $title/difficulty
@onready var accuracy: Label = $data/acc/value
@onready var score: Label = $data/score/value
@onready var increment: Label = $data/score/increment
@onready var new_best: Label = $data/score/new_best
@onready var rating: Label = $data/stat/rating
@onready var stardust: Label = $data/stat/stardust
@onready var pf_stardust: Label = $user_profile/stardust/count
@onready var perfect: Label = $data/stat/perfect
@onready var good: Label = $data/stat/good
@onready var bad: Label = $data/stat/bad
@onready var miss: Label = $data/stat/miss
@onready var rank: Label = $data/stat/rank
@onready var rank_background: ColorRect = $data/stat/rank/display
@onready var times_graph: ColorRect = $data/judgement_times/graph

var _stardust_increment: int = 0
var _score_increment: int = 0

var playing_stat: Array = []

func _tween_before() -> void:
	perfect.set_value_override(0)
	good.set_value_override(0)
	bad.set_value_override(0)
	miss.set_value_override(0)
	accuracy.set_value_override(0)
	score.set_value_override(0)

func _tween_enter() -> void:
	await get_tree().create_timer(0.25).timeout
	stardust.set_value(_stardust_increment)
	perfect.set_value(playing_stat[0])
	good.set_value(playing_stat[1])
	bad.set_value(playing_stat[2])
	miss.set_value(playing_stat[3])
	accuracy.set_value(playing_stat[6])
	score.set_value(playing_stat[8])
	increment.set_value(_score_increment)

func load_info(info: Dictionary) -> void:
	var diff: Dictionary = info.difficulty

	var save: String = info.save
	var save_data: Dictionary = DataManager.get_save(save)
	var stat: Array = playing_stat
	var _score: int = ceili(stat[8])
	_score_increment = _score - save_data.score
	var _rank: int = -1
	for i: int in DataManager.rank_score:
		if _score >= i * 10000:
			_rank += 1
		else:
			break

	save_data.merge({
		accuracy = maxf(stat[6], save_data.accuracy),
		score = maxi(_score, save_data.score),
		rank = maxi(_rank, save_data.rank),
	}, true)
	DataManager.set_save(save, save_data)
	DataManager.save_save()

	var diff_value: float = floorf(diff.value) + ( 0.5 if diff.plus else 0.0 )
	_stardust_increment = ceili( ( 4.0 * diff_value + 26.0 * _score ) / 10000000.0 )
	_stardust_increment += ceili( 3.6 * pow(diff_value, 1.2) * pow(2.71828, 4.0 * _score / 10000000.0 - 4.0) )
	var _stardust: int = DataManager.get_save(\"stardust\") + _stardust_increment
	DataManager.set_save(\"stardust\", _stardust)
	pf_stardust._tween_before()

	difficulty.set_difficulty(diff)
	title.load_text(info.title)
	artist.load_text(info.artist)
	if _score_increment > 0:
		new_best.visible = true 
	else:
		new_best.visible = false

	rank.text = DataManager.rank[_rank]
	var color: Array = DataManager.rank_color[_rank]
	var _material: ShaderMaterial = rank_background.material
	_material.set_shader_parameter(\"color_a\", color[0])
	_material.set_shader_parameter(\"color_b\", color[1])
	times_graph._draw_data(playing_stat[9])
	illust.texture = info.illust_image
"

