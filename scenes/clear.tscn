[sub_resource type="GDScript" id="GDScript_dqkch"]
script/source = "extends \"res://scripts/generic_number_anim.gd\"

func _process(_delta: float) -> void:
	text = str(_calcuate_float(0.0001) * 100.0).pad_decimals(2) + \"%\"
"

[sub_resource type="GDScript" id="GDScript_0od80"]
script/source = "extends \"res://scripts/generic_number_anim.gd\"

func _process(_delta: float) -> void:
	var score_text: String = str(_calcuate_int()).pad_zeros(8)
	for i: int in range(score_text.length() - 1, 0, -1):
		if i % 3 == 0:
			score_text = score_text.insert(score_text.length() - i, \",\")
	text = score_text
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ifow5"]
shader = ExtResource("30_le6tq")
shader_parameter/begin = Vector2(0, 0)
shader_parameter/end = Vector2(1, 1)
shader_parameter/color_a = Vector4(0.6, 0.8, 0.937, 1)
shader_parameter/color_b = Vector4(0.8, 0.8, 1, 1)
shader_parameter/angle = 90.0

[sub_resource type="GDScript" id="GDScript_le6tq"]
script/source = "extends \"res://scripts/generic_number_anim.gd\"

func _process(_delta: float) -> void:
	var increment: int = _calcuate_int()
	var score_text: String = str(increment).pad_zeros(8)
	for i: int in range(score_text.length() - 1, 0, -1):
		if i % 3 == 0:
			score_text = score_text.insert(score_text.length() - i, \",\")
	text = ( \"+\" if increment > 0 else \"\" ) + score_text
"

[sub_resource type="GDScript" id="GDScript_gwr70"]
script/source = "extends \"res://scripts/generic_number_anim.gd\"

var increment_sign: String = \"+\"

func _process(_delta: float) -> void:
	text = increment_sign + str(_calcuate_float(0.0001) * 100.0).pad_decimals(2)
"

