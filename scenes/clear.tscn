[sub_resource type="GDScript" id="GDScript_igqou"]
script/source = "extends ColorRect

var _times: Array = []

func _draw_data(times: Array) -> void:
	_times = times
	queue_redraw()

func _draw() -> void:
	var width: float = 555.0 / 38.0
	var columns: Array = []
	columns.resize(39)
	columns.fill(0)
	var total: int = 0
	for time: int in _times:
		var column: int = clampi( floori( time / 10.0 + 19.5 ), 0, 38)
		columns[column] += 1
		total = maxi(total, columns[column])
	if total > 0:
		for i: int in 38:
			var column: int = columns[i]
			if column > 0:
				var height: float = column * 215.0 / total
				draw_rect(Rect2( ( i + 0.2 ) * width, 215.0 - height, width * 0.6, height ), Color(0xD3D3D3FF), true, -1.0, true)
"

[sub_resource type="GDScript" id="GDScript_2o4a8"]
script/source = "extends \"res://scripts/generic_button.gd\"

func _pressed() -> void:
	SceneManager.unknown_function()
"

[sub_resource type="GDScript" id="GDScript_jnpdl"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node2D

func _pressed() -> void:
	await SceneManager.change_scene(\"player\")
	root.player.restart()
"

[sub_resource type="GDScript" id="GDScript_xeyld"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node2D

func _pressed() -> void:
	var node: Node2D = await SceneManager.change_scene(\"song_select\")
	node.load_chapter()
	root.player.stop()
	root.player.unload_ui()
"

