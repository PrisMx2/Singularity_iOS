[sub_resource type="GDScript" id="GDScript_6fkkf"]
script/source = "extends Node2D

const diff_data: Array = [
	[\"EASY\", \"TIER #0\", Color(0x99CCEFFF), Color(0x99CCEFFF)],
	[\"NORMAL\", \"TIER #1\", Color(0xF0C040FF), Color(0xF0C040FF)],
	[\"HARD\", \"TIER #2\", Color(0xFF5080FF), Color(0xFF5080FF)],
	[\"ALOOF\", \"TIER #3\", Color(0xCCCCFFFF), Color(0xCCCCFFFF)],
	[\"EXPR\", \"TIER #4\", Color(0x7EF6AEFF), Color(0x7EF6AEFF)],
	[\"SPECIAL\", \"TIER #5\", Color(0x8FFFDCFF), Color(0x7CC0FFFF)],
	[\"UNKNOWN\", \"TIER #?\", Color(0xD3D3D3FF), Color(0xD3D3D3FF)],
]

@onready var title: Label = $chapter/title
@onready var title_tip: Label = $chapter/title_tip
@onready var title_en: Label = $chapter/title_en

@onready var song_selection_anchor: Node2D = $song_selection/anchor
@onready var song_selection_item: Label = $song_selection/anchor/title
@onready var song_selected_title: Label = $selected/song/mask/title
@onready var song_selected_artist: Label = $selected/song/mask/artist
@onready var song_tag: Label = $song/fit_tag/tag
@onready var song_title: Label = $song/fit_info/title
@onready var song_artist: Label = $song/fit_info/artist
@onready var song_score: Label = $song/personal_best/score
@onready var song_divider: ColorRect = $song/personal_best/divider
@onready var song_acc: Label = $song/personal_best/acc_value
@onready var song_rank: Label = $song/personal_best/rank
@onready var song_rank_background: ColorRect = $song/personal_best/rank/display
@onready var diff_selection_anchor: Node2D = $difficulty_selection/rotation/anchor
@onready var diff_selection_item: Control = $difficulty_selection/rotation/anchor/transform
@onready var diff_selected: Control = $selected/difficulty/difficulty
@onready var ongoing: Sprite2D = $chapter/explore/ongoing
@onready var completed: Sprite2D = $chapter/explore/completed
@onready var progress: ColorRect = $chapter/progress_bar/frame/value
@onready var play: Button = $song/play
@onready var lock: Control = $song/play/lock

var _song_index: int = -1
var _song_items: Array = []

var _diff_index: int = -1
var _diff_items: Array = []

var _stable: Array = [ true, true ]

var _preview: AudioStreamPlayer
var _preview_stream: AudioStreamOggVorbis
var _preview_stream_status: int = 0
var _preview_tween: Tween = create_tween()
var _preview_status: int = 0
var _focus_record: bool = false

var last_scene: String = \"\"

var chapter: String = \"\"
var chapter_data: Array = []
var title_color: Color = Color(1.0, 1.0, 1.0, 1.0)

var current_chart: Dictionary = {}

func _tween_before() -> void:
	load_chapter()
	started(0)
	song_title.set_decrease_override()
	song_artist.set_decrease_override()
	song_score.set_value_override(0)
	song_acc.set_value_override(0)
	song_rank.set_hide_override()

func _tween_enter() -> void:
	stopped(0)

func _tween_leave() -> void:
	await stop_preview()
	_preview_status = 0

func _ready() -> void:
	song_selection_anchor.started.connect(started.bind(0))
	song_selection_anchor.stopped.connect(stopped.bind(0))
	diff_selection_anchor.started.connect(started.bind(1))
	diff_selection_anchor.stopped.connect(stopped.bind(1))

	_preview = AudioStreamPlayer.new()
	add_child(_preview)
	_preview.bus = \"bgm\"
	_preview.volume_linear = 0.0

func started(key: int) -> void:
	_stable[key] = false
	song_tag.set_value(false)
	song_title.set_decrease()
	song_artist.set_decrease()
	song_score.set_value(0)
	song_acc.set_value(0)
	song_rank.set_hide()
	stop_preview()

func stopped(key: int) -> void:
	_stable[key] = true
	if _stable[0] and _stable[1]:

		var test: Array = current_chart.test
		var overrides: Dictionary = {} if test.is_empty() else test[1]
		lock.visible = not test.is_empty()

		var tag: String = current_chart.tag
		if overrides.has(\"tag\"):
			tag = overrides.tag[0]
		if tag.length() > 0:
			song_tag.text = tag
			song_tag.set_value(true)
		if overrides.has(\"title\"):
			song_title.set_increase(overrides.title[0])
		else:
			song_title.set_increase(current_chart.title)
		if overrides.has(\"artist\"):
			song_artist.set_increase(overrides.artist[0])
		else:
			song_artist.set_increase(current_chart.artist)

		if current_chart.save:
			var save: Dictionary = DataManager.get_save(current_chart.save)
			song_score.set_value(save.score)
			song_acc.set_value(save.accuracy)
			song_rank.text = DataManager.rank[save.rank]
			var color: Array = DataManager.rank_color[save.rank]
			var _material: ShaderMaterial = song_rank_background.material
			_material.set_shader_parameter(\"color_a\", color[0])
			_material.set_shader_parameter(\"color_b\", color[1])
			song_rank.set_unhide()
		else:
			song_score.set_value(randi_range(0, 99999999))
			song_acc.set_value(randf_range(0.0, 9.99))
			song_rank.set_hide()

		var song_count: int = 0
		var clear_count: int = 0

		for song_data: Dictionary in chapter_data:
			song_count += 1 
			for chart: Dictionary in song_data.chart:
				if chart.save:
					var data: Dictionary = DataManager.get_save(chart.save)
					if data.rank > 0:
						clear_count += 1
					break

		var percent: float = float(clear_count) / song_count if song_count > 0 else 0.0
		progress.set_value_break(percent)

		if clear_count == song_count:
			ongoing.visible = false
			completed.visible = true
		else:
			ongoing.visible = true
			completed.visible = false

		if current_chart.path and ( test.is_empty() or not overrides.has(\"hide_preview\") ):
			var song_path: String = current_chart.path
			var chart_path: String = song_path.path_join(current_chart.id)
			var music_path: String = chart_path.path_join(\"music.ogg\")
			if not ResourceLoader.exists(music_path):
				music_path = song_path.path_join(\"music.ogg\")
			WorkerThreadPool.add_task(thread_preview.bind(music_path))

func unload_illust() -> void:
	for song_data: Dictionary in chapter_data:
		for chart: Dictionary in song_data.chart:
			if current_chart != chart:
				chart.erase(\"illust_image\")

func reset() -> void:
	song_selection_anchor.reset()
	diff_selection_anchor.reset()

func load_chapter() -> void:

	_song_index = -1
	_diff_index = -1

	title.add_theme_color_override(\"font_color\", title_color)
	title.text = \"chapter.\" + chapter + \".title_main\"
	title_tip.text = \"chapter.\" + chapter + \".title_tip\"
	title_en.text = \"chapter.\" + chapter + \".title_en\"

	chapter_data = DataManager.get_chapter(chapter).duplicate_deep()
	for i: int in range(chapter_data.size()-1, -1, -1):
		var chart_list: Array = chapter_data[i].chart
		for j: int in range(chart_list.size()-1, -1, -1):
			var chart: Dictionary = chart_list[j]
			chart.test = []
			if chart.save:
				var save_data: Dictionary = DataManager.get_save(chart.save)
				if not save_data.unlock:
					var test: Array = Unlock.test_visibility(chart.save)
					if not test.is_empty() and not test[0]:
						chart_list.remove_at(j)
					else:
						test = Unlock.test_accessibility(chart.save)
						if test.is_empty():
							chart.test = []
							save_data.merge({
								unlock = true
							}, true)
							DataManager.set_save(chart.save, save_data)
						else:
							chart.test = test
		if chart_list.size() == 0:
			chapter_data.remove_at(i)
	var rotate_limit: Vector2 = Vector2( 1.0 - chapter_data.size(), 0.0 )
	rotate_limit += Vector2(-0.5, 0.5)
	song_selection_anchor.rotate_limit = rotate_limit

	for item: Label in _song_items:
		song_selection_anchor.remove_child(item)
	_song_items = []
	for i: int in 12:
		var new_item: Label = song_selection_item.duplicate()
		new_item.rotation = TAU * i / 12.0
		new_item.visible = true
		_song_items.append(new_item)
		song_selection_anchor.add_child(new_item)

	for item: Control in _diff_items:
		diff_selection_anchor.remove_child(item)
	_diff_items = []
	for i: int in 20:
		var new_item: Control = diff_selection_item.duplicate()
		new_item.offset_transform_rotation = TAU * i / 20.0
		new_item.visible = true
		_diff_items.append(new_item)
		diff_selection_anchor.add_child(new_item)

	load_illust()

func load_illust() -> void:
	for song_data: Dictionary in chapter_data:
		for chart: Dictionary in song_data.chart:
			if chart.has(\"illust_image\"):
				continue
			if chart.path:
				var chart_illust_path: String = chart.path.path_join(chart.id + \".png\")
				var song_illust_path: String = chart.path.path_join(\"illust.png\")
				if ResourceLoader.exists(chart_illust_path):
					chart.illust_image = ResourceLoader.load(chart_illust_path)
					continue
				elif ResourceLoader.exists(song_illust_path):
					chart.illust_image = ResourceLoader.load(song_illust_path)
					continue
			chart.illust_image = preload(\"res://textures/generic/missing_illust.jpg\")

func stop() -> bool:
	if current_chart.test.is_empty():
		song_selection_anchor.stop()
		diff_selection_anchor.stop()
		return true
	else:
		return false

func stop_preview() -> bool:
	var rec: int = _preview_status
	_preview_status = -( absi(rec) + 1 )
	if _preview_tween.is_running():
		if rec >= 0:
			_preview_tween.kill()
		else:
			return false
	_preview_tween = create_tween()
	_preview_tween.set_ease(Tween.EASE_IN)
	_preview_tween.set_trans(Tween.TRANS_SINE)
	_preview_tween.tween_property(_preview, \"volume_linear\", 0.0, 0.5)
	await _preview_tween.finished
	_preview.stop()
	return true

func play_preview(stream: AudioStreamOggVorbis) -> bool:
	var rec: int = _preview_status
	_preview_status = ( absi(rec) + 1 ) * signi(rec)
	rec = _preview_status
	if _preview_tween.is_running():
		await _preview_tween.finished
	if _preview_status == rec and is_inside_tree():
		_preview_status = 0
	else:
		return false
	_preview.stream = stream
	_preview.play(current_chart.preview.begin / 1000.0)
	_preview_tween = create_tween()
	_preview_tween.set_ease(Tween.EASE_IN)
	_preview_tween.set_trans(Tween.TRANS_SINE)
	_preview_tween.tween_property(_preview, \"volume_linear\", 1.0, 0.5)
	await _preview_tween.finished
	return true

func thread_preview(path: String) -> void:
	_preview_stream_status += 1
	var rec: int = _preview_stream_status
	_preview_stream = AudioStreamOggVorbis.load_from_file(path)
	if _preview_stream_status == rec:
		call_deferred(\"play_preview\",_preview_stream)

func _notification(what: int) -> void:
	if what == MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT:
		_focus_record = _preview.playing
		_preview.stream_paused = true
	elif what == MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN:
		if _focus_record:
			await get_tree().process_frame
			_preview.stream_paused = false

func _process(_delta: float) -> void:

	if chapter_data.is_empty():
		return

	for item: Label in _song_items:
		item.text = \"\"

	for _index: int in chapter_data.size():
		var index: int = _index + song_selection_anchor.index
		var chart_list: Array = chapter_data[_index].chart
		if index >= -4 and index <= 4:
			var item_index: int = wrapi(_index, 0, 12)
			var chart: Dictionary = chart_list[0]

			var test: Array = chart.test
			var overrides: Dictionary = {} if test.is_empty() else test[1]

			if overrides.has(\"title\"):
				_song_items[item_index].text = overrides.title[0]
			else:
				_song_items[item_index].text = chart.title
			if index == 0 and _song_index != _index:
				_song_index = _index
				_diff_index = -1
				var rotate_limit: Vector2 = Vector2( 1.0 - chart_list.size(), 0.0 )
				rotate_limit += Vector2(-0.5, 0.5)
				diff_selection_anchor.rotate_limit = rotate_limit

	for item: Control in _diff_items:
		item.visible = false

	var current_chart_list: Array = chapter_data[_song_index].chart
	for _index: int in current_chart_list.size():
		var index: int = _index + diff_selection_anchor.index
		var chart: Dictionary = current_chart_list[_index]

		var test: Array = chart.test
		var overrides: Dictionary = {} if test.is_empty() else test[1]

		var diff: Dictionary = chart.difficulty
		if overrides.has(\"difficulty\"):
			diff.override = overrides.difficulty[0]
		var display: Array = diff_data[diff.index]
		diff.display = display
		if index >= -6 and index <= 6:
			var item_index: int = wrapi(_index, 0, 20)
			var item: Control = _diff_items[item_index]
			item.visible = true
			item.set_difficulty(diff)
			if index == 0 and _diff_index != _index:
				_diff_index = _index
				current_chart = chart

				song_selected_title.load_text(chart.title)
				song_selected_artist.load_text(chart.artist)

				diff_selected.set_difficulty(diff)
				var _material: ShaderMaterial = song_divider.material
				_material.set_shader_parameter(\"color_a\", display[2])
				_material.set_shader_parameter(\"color_b\", display[3])

				lock.visible = not test.is_empty()
				if overrides.has(\"title\"):
					song_selected_title.load_text(overrides.title[0])
				if overrides.has(\"artist\"):
					song_selected_artist.load_text(overrides.artist[0])

	var test: Array = current_chart.test
	var overrides: Dictionary = {} if test.is_empty() else test[1]
	if test.is_empty() or not overrides.has(\"hide_illust\"):
		play.icon = current_chart.illust_image
	else:
		play.icon = preload(\"res://textures/generic/unknown_illust.png\")

	if _preview.playing and _preview_status == 0:
		var time: float = _preview.get_playback_position() * 1000.0
		if current_chart.preview.end - time < 500.0:
			if await stop_preview():
				play_preview(_preview_stream)
"

[sub_resource type="GDScript" id="GDScript_crkbu"]
script/source = "extends \"res://scripts/generic_progress_bar.gd\"

@export var label: Label

func _process(_delta: float) -> void:
	label.text = str(int(_update() * 100.0)) + \"%\"
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vefgq"]
shader = ExtResource("25_fnb7a")

[sub_resource type="GDScript" id="GDScript_wvhbo"]
script/source = "extends Button

@export var root: Node

@onready var center: Vector2 = size / 2.0

var _touch_index: int = -1

func _tween_break() -> void:
	_touch_index = -1
	button_up.emit()

func _pressed() -> void:
	if root.stop():
		if root.chapter == \"editor\":
			var editor: Node2D = await SceneManager.change_scene(\"editor\")
			var chart_info: Dictionary = root.current_chart
			editor.load_chart(chart_info)
		else:
			var player: Node3D = await SceneManager.change_scene(\"player\")
			var chart_info: Dictionary = root.current_chart
			player.load_chart(chart_info)
			player.load_ui()
		root.unload_illust()
	else:
		var unlock: Node2D = await SceneManager.insert(\"unlock\")
		unlock.load_data(root.current_chart)

func _ready() -> void:
	disabled = true
	mouse_filter = Control.MOUSE_FILTER_PASS
	add_theme_color_override(\"icon_disabled_color\", Color.WHITE)
	connect(\"pressed\", func():
		SoundManager.play(\"play\")
		_pressed()
	)
	connect(\"button_down\", func():
		self_modulate.v = 0.8
	)
	connect(\"button_up\", func():
		self_modulate.v = 1.0
	)

func _gui_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed == true:
			if _touch_index == -1:
				if ( event.position - center ).length() > center.x:
					return
				_touch_index = event.index
				button_down.emit()
				accept_event()
		elif event.index == _touch_index:
			_touch_index = -1
			pressed.emit()
			button_up.emit()
			accept_event()
	elif event is InputEventScreenDrag:
		if event.index == _touch_index:
			if ( event.position - center ).length() > center.x:
				_touch_index = -1
				button_up.emit()
			accept_event()
"

