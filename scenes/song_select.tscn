[sub_resource type="GDScript" id="GDScript_jida4"]
script/source = "extends Control

func _ready() -> void:
	var ring: Sprite2D = get_child(0)
	var new_material: ShaderMaterial = ShaderMaterial.new()
	new_material.shader = preload(\"res://shaders/ui/gradient.gdshader\")
	ring.material = new_material

func set_difficulty(diff: Dictionary) -> void:
	var ring: Sprite2D = get_child(0)
	var display: Array = diff.display
	ring.material.set_shader_parameter(\"color_a\", display[2])
	ring.material.set_shader_parameter(\"color_b\", display[3])
"

