"

[sub_resource type="GDScript" id="GDScript_ifow5"]
script/source = "extends ColorRect

const columns: int = 150
const radius_begin: float = 368.0
const radius_range: float = 127.0
const angle_begin: float = deg_to_rad(-130.0)
const angle_range: float = deg_to_rad(260.0)
const max_freq: float = 9600.0

var spectrum: AudioEffectSpectrumAnalyzerInstance

func _ready() -> void:
	spectrum = AudioServer.get_bus_effect_instance(AudioServer.get_bus_index(\"bgm\"), 0)

func _draw() -> void:
	draw_set_transform(size / 2.0, angle_begin)
	var step: float = max_freq / columns
	var angle_step: float = angle_range / columns
	for column: int in columns:
		var begin_freq: float = column * step
		var end_freq: float = begin_freq + step
		var magnitude: Vector2 = spectrum.get_magnitude_for_frequency_range(begin_freq, end_freq)
		var energy: float = magnitude.length()
		var normalized: float = pow(clamp((linear_to_db(energy) + 60.0) / 60.0, 0.0, 1.0), 2.0)
		var angle: float = ( column + 0.2 ) * angle_step
		var radius: float = radius_range * normalized
		draw_arc(Vector2(0.0, 0.0), radius_begin + radius / 2.0, angle, angle + angle_step * 0.6, 24, Color(0xFFFFFF44), radius, true)

func _process(_delta: float) -> void:
	queue_redraw()
"

