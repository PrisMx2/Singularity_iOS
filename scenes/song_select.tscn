script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node

func _pressed() -> void:
	await SceneManager.change_scene(root.last_scene)
	root.unload_illust()
"

[sub_resource type="GDScript" id="GDScript_8fkps"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node2D

func _pressed() -> void:
	var node: Node2D = await SceneManager.change_scene(\"settings\")
	node.last_scene = \"song_select\"
"

