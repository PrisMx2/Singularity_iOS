[sub_resource type="GDScript" id="GDScript_igqou"]
script/source = "extends \"res://scripts/generic_button.gd\"

func _pressed() -> void:
	var node: Node = await SceneManager.insert(\"chapter_confirm\")
	node.last_scene = \"main\"
	node.chapter = \"editor\"
	node.load_chapter()

func _process(_delta: float) -> void:
	self_modulate.h = wrapf(self_modulate.h + _delta, 0.0, 1.0)
"

