[sub_resource type="GDScript" id="GDScript_muem4"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var dialog: Label

func _pressed() -> void:
	dialog.set_decrease_override()
	dialog.set_increase(str(randi()).repeat(2))
"

