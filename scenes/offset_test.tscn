[sub_resource type="GDScript" id="GDScript_emhwf"]
script/source = "extends Node2D

@onready var offset_value: Label = $offset/value
@onready var offset_suggested: Label = $offset/suggested

var _note_multimesh: MultiMesh
var _note_material: ShaderMaterial
var _note_data: Array = []

var _effect: bool = false
var _effect_data: Array = []

var _player: FmodOggPlayer
var _music_start: float = 0.0
var _music_offset: int = 0

var sound_mode: int = 0
var beat_filter: int = 4

var last_scene: String = \"\"

func _tween_before() -> void:
	_note_data = []
	for i: int in 16:
		_note_data.append([ ( i + 4 ) * 125.0, false, i == 12 - 4 ])
	_music_offset = DataManager.get_save(\"settings.music_offset\", 0)
	_music_start = _get_time()
	_player.set_volume(DataManager.get_save(\"settings.music_volume\"))
	_player.play()
	add(0)

func _tween_leave() -> void:
	_player.stop()

func _get_time() -> float:
	return Time.get_ticks_usec() / 1000.0

func get_player_time() -> float:
	return maxf(_get_time() - _music_start - _music_offset, 0.0)

func _init_render() -> void:

	var aabb: AABB = AABB(Vector3(), Vector3.ONE)

	var quad_mesh: QuadMesh = QuadMesh.new()
	quad_mesh.size = Vector2(1.0, 1.0)
	quad_mesh.subdivide_width = 0
	quad_mesh.subdivide_depth = 0

	_note_multimesh = MultiMesh.new()
	_note_multimesh.custom_aabb = aabb
	_note_multimesh.use_custom_data = true
	_note_multimesh.transform_format = MultiMesh.TRANSFORM_2D
	_note_multimesh.mesh = quad_mesh
	_note_multimesh.instance_count = 320
	_note_multimesh.visible_instance_count = 0
	$mask/note_multimesh.multimesh = _note_multimesh

	_note_material = ShaderMaterial.new()
	_note_material.shader = preload(\"res://shaders/player/offset.gdshader\")
	_note_material.render_priority = 0
	$mask/note_multimesh.material = _note_material

func add(value: int) -> void:
	_music_offset += value
	_music_offset = clampi(_music_offset, -999, 999)
	DataManager.set_save(\"settings.music_offset\", _music_offset)
	offset_value.text = str(_music_offset) + \" ms\"

func _ready() -> void:
	_init_render()
	_player = FmodServer.create_player_by_ogg(\"res://sounds/offset_test.ogg\")
	_player.set_loop(true)

func _unhandled_input(event: InputEvent) -> void:

	if event is InputEventScreenTouch:
		if event.pressed and not event.canceled:

			if sound_mode == 1 or sound_mode == 3:
				SoundManager.play(\"tap\")

			_effect = true
			var time: float = get_player_time()
			var offset_comp: float = 999999.0
			var offset_record: float = 0.0

			for i: int in 16:
				if i % mini(beat_filter, 4) > 0:
					continue
				var note: Array = _note_data[i]
				var delta_time: float = note[0] - time
				if absf(delta_time) < offset_comp:
					offset_comp = absf(delta_time)
					offset_record = delta_time

			offset_suggested.text = \"(\" + str(int(offset_record)) + \" ms)\"

func _process(_delta: float) -> void:

	var time: float = get_player_time()
	var time_raw: float = _get_time()

	var note_index: int = 0

	for i: int in range(_effect_data.size()-1, -1, -1):
		var effect: Array = _effect_data[i]
		var progress: float = maxf(time_raw - effect[1], 0.0) / 600
		if progress > 1.0:
			_effect_data.remove_at(i)
			continue
		var delta_time: float = effect[0]
		var _position: Vector2 = Vector2(delta_time * 690.0, 0.0)
		progress = Easings.Function[4].call(progress) / 2.0 + 0.5
		_note_multimesh.set_instance_custom_data(note_index, Color(delta_time, progress, effect[2], 0.0))
		_note_multimesh.set_instance_transform_2d(note_index, Transform2D(0.0, _position))
		note_index += 1

	for i: int in 16:
		var note: Array = _note_data[i]
		var delta_time: float = time - note[0]
		if delta_time > 1000.0:
			delta_time += 2000.0
			note[0] += 2000.0
			note[1] = false
		if i % beat_filter > 0 or beat_filter == 8:
			continue
		delta_time /= 1000.0
		var extended: float = 100.0 if note[2] else 0.0
		if _effect:
			_effect_data.append([ delta_time, time_raw, extended ])
		var _position: Vector2 = Vector2(delta_time * 690.0, 0.0)
		_note_multimesh.set_instance_custom_data(note_index, Color(delta_time, 0.0, extended, 0.0))
		_note_multimesh.set_instance_transform_2d(note_index, Transform2D(0.0, _position))
		note_index += 1

	_effect = false

	_note_multimesh.visible_instance_count = note_index

func _physics_process(_delta: float) -> void:

	var time: float = get_player_time()

	for i: int in 16:
		var note: Array = _note_data[i]
		var delta_time: float = time - note[0]
		if delta_time > 0.0 and not note[1]:
			note[1] = true
			if i % beat_filter > 0 or beat_filter == 8:
				continue
			if sound_mode == 1 or sound_mode == 2:
				SoundManager.play(\"flick\" if note[2] else \"drag\")
"

