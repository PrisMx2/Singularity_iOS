[sub_resource type="GDScript" id="GDScript_348ts"]
script/source = "extends Button

@export var root: Node2D
@export var label: Label
@export var on: Sprite2D

var _switch: int = 0

func _pressed() -> void:
	_switch = wrapi(_switch + 1, 0, 4)
	root.sound_mode = _switch
	label.text = \"offset_test.sound_\" + str(_switch)
	on.visible = false if _switch == 0 else true
"

[sub_resource type="GDScript" id="GDScript_xeyld"]
script/source = "extends Button

@export var root: Node2D
@export var label: Label
@export var on: Sprite2D

var _switch: int = 2

func _pressed() -> void:
	_switch = wrapi(_switch + 1, 1, 5)
	root.beat_filter = 2 ** ( 4 - _switch )
	label.text = \"offset_test.div_\" + str(_switch)
	on.visible = false if _switch == 1 else true
"

