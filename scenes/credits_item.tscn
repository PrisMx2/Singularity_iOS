[sub_resource type="GDScript" id="GDScript_4t34j"]
script/source = "extends VBoxContainer

const cut: int = 15

@onready var fit: HBoxContainer = $fit
@onready var title: Label = $fit/title
@onready var names: Label = $fit/names

func set_data(data: Array) -> void:
	var _names: Array = data[1]
	title.text = ( \"[%s]\\nA-Z\" if _names.size() > 1 else \"[%s]\" ) % tr(data[0])
	fit.remove_child(names)
	var index: int = 0
	while index < _names.size():
		var new_names: Label = names.duplicate()
		fit.add_child(new_names)
		new_names.text = \"\\n\".join(_names.slice(index, index + cut))
		index += cut
"

