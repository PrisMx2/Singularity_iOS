[sub_resource type="GDScript" id="GDScript_tt4sw"]
script/source = "extends Node2D

@onready var title: Label = $chapter/title
@onready var title_tip: Label = $chapter/fit/title_tip
@onready var title_en: Label = $chapter/fit/margin/title_en
@onready var context: Label = $context/text

@onready var clear_sum: Label = $cleared/sum
@onready var clear_value: Label = $cleared/value
@onready var fc_sum: Label = $fc/sum
@onready var fc_value: Label = $fc/value
@onready var ap_sum: Label = $ap/sum
@onready var ap_value: Label = $ap/value
@onready var ongoing: Sprite2D = $explore/ongoing
@onready var completed: Sprite2D = $explore/completed

var last_scene: String = \"\"

var chapter: String = \"\"
var chapter_data: Array = []
var title_color: Color = Color(1.0, 1.0, 1.0, 1.0)

func _tween_before() -> void:
	modulate.a = 0.0

func _tween_enter() -> void:
	var tween: Tween = create_tween()
	tween.set_ease(Tween.EASE_IN)
	tween.set_trans(Tween.TRANS_QUAD)
	tween.tween_property(self, \"modulate:a\", 1.0, 0.2).from(0.0)
	await tween.finished

func _tween_leave() -> void:
	var tween: Tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_QUAD)
	tween.tween_property(self, \"modulate:a\", 0.0, 0.2).from(1.0)
	await tween.finished

func load_chapter() -> void:

	var song_count: int = 0
	var chart_count: int = 0
	var clear_count: int = 0
	var fc_count: int = 0
	var ap_count: int = 0

	title.add_theme_color_override(\"font_color\", title_color)
	title.text = \"chapter.\" + chapter + \".title_main\"
	title_tip.text = \"chapter.\" + chapter + \".title_tip\"
	title_en.text = \"chapter.\" + chapter + \".title_en\"
	context.text = \"chapter.\" + chapter + \".context\"

	chapter_data = DataManager.get_chapter(chapter)
	for song: Dictionary in chapter_data:
		song_count += 1
		var clear: bool = false
		for chart: Dictionary in song.chart:
			if chart.save:
				chart_count += 1
				var data: Dictionary = DataManager.get_save(chart.save)
				if data.rank > 0 and not clear:
					clear_count += 1
					clear = true

	clear_sum.text = \"/\" + str(song_count)
	var chart_count_text: String = \"/\" + str(chart_count)
	fc_sum.text = chart_count_text
	ap_sum.text = chart_count_text
	clear_value.text = str(clear_count)
	fc_value.text = str(fc_count)
	ap_value.text = str(ap_count)

	if clear_count == chart_count:
		ongoing.visible = false
		completed.visible = true
	else:
		ongoing.visible = true
		completed.visible = false
"

