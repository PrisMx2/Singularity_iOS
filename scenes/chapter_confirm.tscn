[sub_resource type="GDScript" id="GDScript_2lqgn"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node2D

func _pressed() -> void:
	await SceneManager.leave(root)
"

[sub_resource type="GDScript" id="GDScript_ua0p4"]
script/source = "extends \"res://scripts/generic_button.gd\"

func _pressed() -> void:
	SceneManager.unknown_function()
"

[sub_resource type="GDScript" id="GDScript_t6wdq"]
script/source = "extends Control

@export var root: Node2D

func _pressed() -> void:
	var node: Node2D = SceneManager.get_scene(\"song_select\")
	node.last_scene = root.last_scene
	node.chapter = root.chapter
	node.chapter_data = root.chapter_data
	node.title_color = root.title_color
	await SceneManager.change_scene_and_leave(\"song_select\", root)
	node.reset()
"

