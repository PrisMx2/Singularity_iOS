[sub_resource type="GDScript" id="GDScript_mhf34"]
script/source = "extends \"res://scripts/generic_input.gd\"

@export var root: Control

func _ready() -> void:
	super._ready()
	text_changed.connect(func(_text: String):
		root.func_set_name(_text)
	)
"

[sub_resource type="GDScript" id="GDScript_ifow5"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var parent: Control

func _pressed() -> void:
	parent.func_solo()
"

