[sub_resource type="GDScript" id="GDScript_6lm8n"]
script/source = "extends Control

const basic_width: float = 19.2
const basic_height: float = 10.8
const basic_center: Vector3 = Vector3(basic_width / 2.0, basic_height / 2.0, 0.0)

const width: float = 190.0
const height: float = 107.0

@onready var index_text: Label = $margin/fit/stack/index
@onready var name_text: LineEdit = $margin/fit/stack/name

var root: Node2D

var index: int = -1

func switch_page(page: int) -> void:
	var pages: Array = root.edit_pages
	var found: int = pages.find(page)
	if found > -1:
		pages.remove_at(found)
	else:
		pages.append(page)
	root._load_pages()

func func_solo() -> void:
	var pages: Array = root.edit_pages
	pages.clear()
	pages.append(index * 2)
	pages.append(index * 2 + 1)
	root._load_pages()

func func_events() -> void:
	switch_page(index * 2)

func func_notes() -> void:
	switch_page(index * 2 + 1)

func func_record() -> void:
	pass

func func_set_name(text: String) -> void:
	if root.valid() and index > -1:
		var line: Array = root.chart_data[1][index]
		line[8] = text

func _ready() -> void:
	if root.valid() and index > -1:
		var line: Array = root.chart_data[1][index]
		name_text.text = line[8]
		index_text.text = str(index)

func _process(_delta: float) -> void:
	queue_redraw()
"

