	await SceneManager.change_scene(\"main_chapters\")
"

[sub_resource type="GDScript" id="GDScript_mhf34"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var last_scene: String = \"\"
@export var chapter: String = \"\"
@export var title_color: Color = Color(1.0, 1.0, 1.0, 1.0)

func _pressed() -> void:
	var node: Node2D = SceneManager.get_scene(\"song_select\")
	node.last_scene = last_scene
	node.chapter = chapter
	node.chapter_data = DataManager.get_chapter(chapter)
	node.title_color = title_color
	await SceneManager.change_scene(\"song_select\")
	node.reset()
"

