[sub_resource type="GDScript" id="GDScript_0xn8j"]
script/source = "extends \"res://scripts/generic_button.gd\"

@export var root: Node2D

func _pressed() -> void:
	await SceneManager.change_scene(\"main\")
"

[sub_resource type="GDScript" id="GDScript_gqmmt"]
script/source = "extends Sprite2D

var tweens: Array = []

func _tween_before() -> void:
	for tween: Tween in tweens:
		tween.kill()
	position.y = 1200.0
	self_modulate.a = 0.0

func _tween_enter() -> void:
	var tween: Tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"position:y\", 247.0, 0.4).from(1200.0)
	tweens.append(tween)

	tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_QUART)
	tween.tween_property(self, \"self_modulate:a\", 1.0, 0.25).from(0.0)
	tweens.append(tween)
"

[sub_resource type="GDScript" id="GDScript_26mhb"]
script/source = "extends Node

@onready var main: Button = $main
@onready var sidestory: Button = $sidestory
@onready var singles: Button = $singles

var tweens: Array = []

func _tween_before() -> void:
	for tween: Tween in tweens:
		tween.kill()
	main.position.y = 1500.0
	sidestory.position.y = 1500.0
	singles.position.y = 1500.0

func _tween_enter() -> void:

	var tween: Tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.tween_interval(0.15)
	tween.tween_property(sidestory, \"position:y\", 215.0, 0.5).from(1500.0)
	tweens.append(tween)

	tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(main, \"position:y\", 178.0, 0.5).from(1500.0)
	tweens.append(tween)

	tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.tween_interval(0.15)
	tween.tween_property(singles, \"position:y\", 215.0, 0.5).from(1500.0)
	tweens.append(tween)
"

